# Clerk server-side secret key for verifying session tokens.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Allowed frontend origin(s) for CORS. Use comma-separated values if needed.
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=

# Pollinations server-side key (required for AI Text-to-Design).
# Keep this as an sk_ key on backend only.
POLLINATIONS_API_KEY=

# Optional Pollinations model override. Default is "flux".
POLLINATIONS_MODEL=flux

# Legacy OpenAI route (optional, only for /api/v1/dalle if you still use it).
OPENAI_API_KEY=
